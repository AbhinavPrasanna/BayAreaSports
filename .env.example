# Run npm run setup to generate a random local database password.
POSTGRES_PASSWORD=replace-with-a-random-local-password
# Optional host-process URL; requires compose.host-db.yaml. Compose services use db:5432 instead.
DATABASE_URL=postgresql://bayline:replace-with-a-random-local-password@127.0.0.1:15432/bayline
ENABLED_LEAGUES=nba,nfl,wnba
WORKER_INTERVAL_SECONDS=60
# Set the real key only in the worker process environment, not in this file.
# The Windows launcher reads the previously configured DPAPI file in memory.
# BALLDONTLIE_API_KEY=
# Optional worker-only YouTube Data API key. Without it, automatic highlights stay disabled.
# Configure with scripts/configure-youtube-key.ps1; never use NEXT_PUBLIC_ for a key.
# YOUTUBE_API_KEY=
HIGHLIGHTS_ENABLED=true
# Optional paid player-stat feeds. Leave empty on the free plan.
PLAYER_STATS_LEAGUES=
