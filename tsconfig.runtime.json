{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "dist-runtime",
    "types": ["node"]
  },
  "include": ["src/worker/main.ts", "scripts/migrate.ts", "scripts/worker-health.ts", "scripts/import-game-media.ts"],
  "exclude": ["node_modules", "dist-runtime"]
}
