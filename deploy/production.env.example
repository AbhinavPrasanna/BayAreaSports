# Deployment inputs only. Actual secret contents live in ./secrets/ (ignored).
AWS_REGION=us-west-2
BACKUP_BUCKET=replace-with-private-backup-bucket
APP_DOMAIN=replace-with-your-domain.example
ACME_EMAIL=replace-with-your-email
# Enable only after DNS and the prelaunch recovery drill pass.
COMPOSE_PROFILES=public
# For an IP-address certificate, set APP_DOMAIN to the static IP and use ./Caddyfile.ip.
CADDY_CONFIG=./Caddyfile
WEB_IMAGE=replace-with-web-repository@sha256:replace-with-digest
WORKER_IMAGE=replace-with-worker-repository@sha256:replace-with-digest
POSTGRES_IMAGE=postgres@sha256:replace-with-verified-17-digest
CADDY_IMAGE=caddy@sha256:replace-with-verified-digest
